# Optional: one process per port, for running behind a load balancer instead of
# uvicorn --workers. Enable e.g. `systemctl enable --now beacn-web@8000 beacn-web@8001`.
# Point your load balancer at 127.0.0.1:8000, 127.0.0.1:8001, …
[Unit]
Description=BEACN web instance on port %i
After=network-online.target beacn-migrate.service postgresql.service redis-server.service
Wants=network-online.target
Requires=beacn-migrate.service

[Service]
Type=exec
User=beacn
Group=beacn
WorkingDirectory=/opt/beacn
EnvironmentFile=/etc/beacn/beacn.env
ExecStart=/opt/beacn/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port %i \
    --proxy-headers --forwarded-allow-ips '*' \
    --timeout-graceful-shutdown 20
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/beacn/storage
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
