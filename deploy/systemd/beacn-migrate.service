[Unit]
Description=BEACN — apply database migrations and seed the RBAC catalogue
# Runs once. beacn-web.service pulls this in and waits for it to finish.
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=beacn.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=beacn
Group=beacn
WorkingDirectory=/opt/beacn
EnvironmentFile=/etc/beacn/beacn.env
# The one process allowed to create schema, regardless of the env file.
Environment=DB_GENERATE_SCHEMAS=true
ExecStart=/opt/beacn/.venv/bin/beacn migrate

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/beacn/storage
