[Unit]
Description=BEACN maintenance jobs (retention prune, counter refresh, connection reaping, idempotency sweep)
After=beacn-web.service
PartOf=beacn.target

[Service]
Type=oneshot
User=beacn
Group=beacn
WorkingDirectory=/opt/beacn
EnvironmentFile=/etc/beacn/beacn.env
Environment=DB_GENERATE_SCHEMAS=false
ExecStart=/opt/beacn/.venv/bin/beacn work

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/beacn/storage
