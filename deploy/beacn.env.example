# /etc/beacn/beacn.env  —  read by every beacn-*.service unit (EnvironmentFile=).
# install.sh writes this file on first run, generating SECRET_KEY. Edit it and
# `systemctl restart beacn.target` to apply.
# Full reference: docs/DEPLOYMENT.md and docs/CONFIGURATION in the app.

# ---- Application --------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://beacn.example.com
SECRET_KEY=__REPLACE_ME__            # openssl rand -hex 32
CORS_ORIGINS=https://beacn.example.com

# ---- Web tier (used by the ExecStart of beacn-web.service) -----------
BEACN_HOST=127.0.0.1
BEACN_PORT=8000
BEACN_WEB_WORKERS=4

# ---- Database --------------------------------------------------------
# install.sh --postgres sets this to the local socket DB it creates.
DATABASE_URL=postgres://beacn:beacn@127.0.0.1:5432/beacn
DB_GENERATE_SCHEMAS=false            # only beacn-migrate.service creates schema

# ---- Event bus / Redis --------------------------------------------------
BEACN_BUS=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=beacn
QUEUE_BACKEND=redis

# ---- Cookies ----------------------------------------------------------
COOKIE_SECURE=true

# ---- Front end ------------------------------------------------------
VITE_DEV=false                       # serve the built static/build/ assets

# ---- Ingestion / retention (defaults shown; tune to taste) ---------
# INGEST_RATE_PER_MINUTE=6000
# INGEST_BURST=600
# EVENT_RETENTION_HOURS=168
# REALTIME_HEARTBEAT_MS=25000
