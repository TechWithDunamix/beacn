# Copy to .env and adjust. Every value here is also the built-in default,
# except SECRET_KEY which you must set for anything but local development.

APP_NAME=BEACN
APP_ENV=local                 # local | development | staging | production
APP_DEBUG=true
APP_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (SQLite for dev, Postgres for production) --------------------
DATABASE_URL=sqlite://storage/beacn.db
# DATABASE_URL=postgres://beacn:beacn@localhost:5432/beacn
DB_GENERATE_SCHEMAS=true      # only the web process; workers set false

# --- Event bus -----------------------------------------------------------
BEACN_BUS=memory              # memory | redis
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=beacn
QUEUE_BACKEND=memory          # memory | redis

# --- Ingestion limits --------------------------------------------------
INGEST_RATE_PER_MINUTE=6000
INGEST_BURST=600
MAX_REQUEST_BYTES=4194304
IDEMPOTENCY_TTL_HOURS=24

# --- Retention -------------------------------------------------------
EVENT_RETENTION_HOURS=168
TASK_RETENTION_HOURS=720
NOTIFICATION_RETENTION_HOURS=720
CONNECTION_RETENTION_HOURS=72

# --- Realtime ------------------------------------------------------
REALTIME_HEARTBEAT_MS=25000
REALTIME_CONNECTION_MAX_SECONDS=43200
REALTIME_QUEUE=512
REALTIME_TOKEN_TTL_SECONDS=3600
REPLAY_MAX_EVENTS=1000

# --- Cookies / CORS ----------------------------------------------
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8000

# --- Front end (dev) -------------------------------------------
VITE_DEV=true
VITE_DEV_SERVER=http://localhost:5173
